{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"paths": {
			"@usenarrator/core": ["./packages/core/src/index.ts"],
			"@usenarrator/lang-ts": ["./packages/lang-ts/src/index.ts"],
			"@usenarrator/lang-ts/oxc": ["./packages/lang-ts/src/oxc.ts"],
			"@usenarrator/lang-ts/wasm": ["./packages/lang-ts/src/wasm.ts"],
			"@usenarrator/locale-en": ["./packages/locale-en/src/index.ts"],
			"@usenarrator/testkit": ["./packages/testkit/src/index.ts"],
			"@usenarrator/node": ["./packages/node/src/index.ts"],
			"@usenarrator/plugin-ai-sdk/en": ["./plugins/ai-sdk/src/en.ts"],
			"@usenarrator/plugin-effect/platform": ["./plugins/effect/src/platform/index.ts"],
			"@usenarrator/plugin-effect/sql": ["./plugins/effect/src/sql/index.ts"],
			"@usenarrator/plugin-effect/testing": ["./plugins/effect/src/testing/index.ts"],
			"@usenarrator/plugin-sql/pgsql": ["./plugins/sql/src/pgsql.ts"],
			"@usenarrator/plugin-*": ["./plugins/*/src/index.ts"],
			"@usenarrator/example-autumn": ["./examples/autumn/src/index.ts"],
			"@usenarrator/cli": ["./apps/cli/src/index.ts"]
		},

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"exclude": ["node_modules", "**/dist", "apps/extension"]
}
