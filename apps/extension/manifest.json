{
	"manifest_version": 3,
	"name": "Narrator for GitHub",
	"version": "0.3.0",
	"description": "Read pull request and commit diffs as plain English, generated deterministically from the code's syntax tree.",
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"https://github.com/*",
		"https://api.github.com/*",
		"https://raw.githubusercontent.com/*"
	],
	"background": {
		"service_worker": "background.js",
		"scripts": [
			"background.js"
		],
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://github.com/*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_idle"
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"web_accessible_resources": [],
	"icons": {
		"128": "icon128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "narrator@usenarrator.dev",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	}
}
