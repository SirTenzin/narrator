{
	"name": "@usenarrator/cli",
	"version": "0.1.0",
	"description": "Narrate TS/JS files and git diffs in plain English from the terminal.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SirTenzin/narrator.git",
		"directory": "apps/cli"
	},
	"homepage": "https://github.com/SirTenzin/narrator#readme",
	"type": "module",
	"sideEffects": false,
	"bin": {
		"narrator": "./dist/bin.js"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@usenarrator/core": "workspace:^",
		"@usenarrator/lang-ts": "workspace:^",
		"@usenarrator/locale-en": "workspace:^",
		"@usenarrator/node": "workspace:^",
		"@usenarrator/plugin-ai-sdk": "workspace:^",
		"@usenarrator/plugin-better-auth": "workspace:^",
		"@usenarrator/plugin-decimal": "workspace:^",
		"@usenarrator/plugin-drizzle": "workspace:^",
		"@usenarrator/plugin-effect": "workspace:^",
		"@usenarrator/plugin-elysia": "workspace:^",
		"@usenarrator/plugin-hono": "workspace:^",
		"@usenarrator/plugin-sql": "workspace:^",
		"@usenarrator/plugin-testing": "workspace:^",
		"@usenarrator/plugin-zod": "workspace:^",
		"oxc-parser": "^0.153.0",
		"pgsql-ast-parser": "^12.0.2"
	},
	"devDependencies": {
		"@usenarrator/example-autumn": "workspace:^"
	}
}
