{
	"name": "narrator",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"plugins/*",
		"examples/*",
		"apps/*"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p apps/extension/tsconfig.json",
		"test": "bun test",
