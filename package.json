	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2",
		"@types/bun": "latest",
		"@types/chrome": "^0.3.4",
		"oxc-parser": "^0.153.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^5"
	}
