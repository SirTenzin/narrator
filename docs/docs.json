{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "aspen",
	"name": "Narrator",
	"description": "Turn TypeScript and JavaScript into plain English, deterministically. No LLM, runs in the browser.",
	"colors": {
		"primary": "#3155C4",
		"light": "#8DA8F0",
		"dark": "#3155C4"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg",
		"href": "https://narrator.ami.rip"
	},
	"favicon": "/favicon.svg",
	"fonts": {
		"family": "Geist"
	},
	"background": {
		"color": {
			"light": "#FFFFFF",
			"dark": "#0A0A0A"
		}
	},
	"appearance": {
		"default": "system"
	},
	"icons": {
		"library": "lucide"
	},
	"styling": {
		"eyebrows": "section",
		"codeblocks": {
			"theme": {
				"light": "github-light-default",
				"dark": "github-dark-default"
			}
		}
	},
	"navbar": {
		"links": [
			{
				"label": "GitHub",
				"href": "https://github.com/SirTenzin/narrator"
			}
		],
		"primary": {
			"type": "button",
			"label": "Get started",
			"href": "https://narrator.ami.rip/getting-started"
		}
	},
	"navigation": {
		"tabs": [
			{
				"tab": "Get started",
				"icon": "book-open",
				"groups": [
					{
						"group": "Get started",
						"pages": [
							"index",
							"getting-started"
						]
					},
					{
						"group": "Concepts",
						"pages": [
							"concepts/how-it-works",
							"concepts/markup",
							"concepts/units-and-diffs",
							"concepts/dependency-detection",
							"concepts/determinism"
						]
					}
				]
			},
			{
				"tab": "Guides",
				"icon": "compass",
				"groups": [
					{
						"group": "Use Narrator",
						"pages": [
							"guides/browser-extension",
							"privacy",
							"guides/embedding"
						]
					},
					{
						"group": "Extend Narrator",
						"pages": [
							"guides/writing-a-plugin",
							"guides/translating",
							"guides/source-languages",
							"guides/plugin-versioning"
						]
					}
				]
			},
			{
				"tab": "Plugins",
				"icon": "puzzle",
				"groups": [
					{
						"group": "Plugins",
						"pages": [
							"plugins/overview"
						]
					},
					{
						"group": "Validation",
						"pages": [
							"plugins/zod",
							"plugins/valibot",
							"plugins/arktype"
						]
					},
					{
						"group": "Data",
						"pages": [
							"plugins/drizzle",
							"plugins/prisma",
							"plugins/kysely",
							"plugins/sql",
							"plugins/decimal"
						]
					},
					{
						"group": "Servers",
						"pages": [
							"plugins/hono",
							"plugins/express",
							"plugins/fastify",
							"plugins/elysia",
							"plugins/trpc"
						]
					},
					{
						"group": "Frontend",
						"pages": [
							"plugins/react",
							"plugins/nextjs",
							"plugins/tanstack-query"
						]
					},
					{
						"group": "Payments, auth & AI",
						"pages": [
							"plugins/stripe",
							"plugins/autumn-js",
							"plugins/better-auth",
							"plugins/ai-sdk"
						]
					},
					{
						"group": "Jobs",
						"pages": [
							"plugins/bullmq",
							"plugins/inngest",
							"plugins/trigger-dev",
							"plugins/temporal"
						]
					},
					{
						"group": "Effect & testing",
						"pages": [
							"plugins/effect",
							"plugins/testing"
						]
					}
				]
			},
			{
				"tab": "Reference",
				"icon": "braces",
				"groups": [
					{
						"group": "Packages",
						"pages": [
							"reference/core",
							"reference/engine",
							"reference/ts-plugin",
							"reference/locale",
							"reference/node",
							"reference/testkit"
						]
					},
					{
						"group": "Tools",
						"pages": [
							"reference/cli"
						]
					}
				]
			}
		]
	},
	"footer": {
		"socials": {
			"github": "https://github.com/SirTenzin/narrator"
		}
	},
	"contextual": {
		"options": [
			"copy",
			"view"
		]
	},
	"seo": {
		"metatags": {
			"og:image": "https://narrator.ami.rip/images/og.png",
			"twitter:image": "https://narrator.ami.rip/images/og.png",
			"twitter:card": "summary_large_image"
		}
	}
}
